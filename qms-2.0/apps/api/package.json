{
  "name": "@qms/api",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "node node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "node node_modules/prisma/build/index.js generate && node node_modules/@nestjs/cli/bin/nest.js build",
    "test": "node node_modules/prisma/build/index.js generate && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathIgnorePatterns=schema.integration-spec.ts --",
    "test:integration": "node node_modules/prisma/build/index.js generate && node node_modules/prisma/build/index.js migrate deploy && node node_modules/prisma/build/index.js db seed && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand test/database/schema.integration-spec.ts",
    "lint": "node node_modules/prisma/build/index.js generate && node node_modules/typescript/bin/tsc --noEmit",
    "db:validate": "node node_modules/prisma/build/index.js validate",
    "test:db-config": "node scripts/check-prisma-config.mjs",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node node_modules/prisma/build/index.js db seed"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "11.1.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.15.30",
    "@types/pg": "^8.15.5",
    "@types/supertest": "6.0.3",
    "jest": "^30.2.0",
    "prisma": "^7.0.0",
    "supertest": "7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
