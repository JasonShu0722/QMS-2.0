{
  "name": "@qms/api",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.21.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "node node_modules/@nestjs/cli/bin/nest.js start --watch",
    "build": "node node_modules/prisma/build/index.js generate && node node_modules/@nestjs/cli/bin/nest.js build",
    "test": "node node_modules/prisma/build/index.js generate && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathIgnorePatterns=integration-spec.ts --",
    "test:integration": "node node_modules/prisma/build/index.js generate && node node_modules/prisma/build/index.js migrate deploy && node node_modules/prisma/build/index.js db seed && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPatterns=integration-spec.ts --testPathIgnorePatterns=worker-process-schema.integration-spec.ts",
    "test:worker-process": "pnpm build && node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand test/task-notification/worker-process-schema.integration-spec.ts",
    "lint": "node node_modules/prisma/build/index.js generate && node node_modules/typescript/bin/tsc --noEmit",
    "security:reencrypt": "node dist/rotate-security-keys.js --reencrypt",
    "data:protect": "node scripts/data-protection.mjs",
    "operations:snapshot": "node scripts/operations-snapshot.mjs",
    "db:validate": "node node_modules/prisma/build/index.js validate",
    "test:db-config": "node scripts/check-prisma-config.mjs",
    "db:generate": "node node_modules/prisma/build/index.js generate",
    "db:migrate:deploy": "node node_modules/prisma/build/index.js migrate deploy",
    "db:seed": "node node_modules/prisma/build/index.js db seed",
    "operations:alerts": "node ../../scripts/operations-alerts.mjs --stdin",
    "test:operations-alerts": "node --test test/operations/operations-alerts.acceptance.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1136.0",
    "@aws-sdk/s3-request-presigner": "3.1136.0",
    "@expo-google-fonts/noto-sans-sc": "0.4.3",
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "11.2.0",
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "dotenv": "^17.2.3",
    "exceljs": "4.4.0",
    "express": "5.2.1",
    "file-type": "22.1.1",
    "nodemailer": "10.0.10",
    "otpauth": "9.5.2",
    "pdfkit": "0.20.2",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@nestjs/testing": "11.1.6",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/nodemailer": "8.0.2",
    "@types/pdfkit": "0.17.5",
    "@types/pg": "^8.15.5",
    "@types/supertest": "6.0.3",
    "fflate": "0.8.3",
    "jest": "^30.2.0",
    "pdfjs-dist": "6.3.289",
    "prisma": "^7.0.0",
    "supertest": "7.1.4",
    "ts-jest": "^29.4.5",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
