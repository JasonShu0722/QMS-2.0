generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  INTERNAL
  SUPPLIER
}

enum OrganizationType {
  INTERNAL
  SUPPLIER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum OrganizationStatus {
  ACTIVE
  DISABLED
}

enum FileStatus {
  QUARANTINED
  AVAILABLE
  DELETED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
}

enum ProblemStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  CLOSED
  ARCHIVED
}

enum WorkflowVersionStatus {
  DRAFT
  PUBLISHED
  RETIRED
}

enum WorkflowNodeType {
  ACTION
  APPROVAL
  VERIFICATION
  CC
  REJECT
  RETURN
  REOPEN
  CLOSE
}

enum WorkflowInstanceStatus {
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
  SUSPENDED
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
  OVERDUE
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Organization {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(64)
  name        String           @db.VarChar(200)
  type        OrganizationType
  parentId    String?          @map("parent_id") @db.Uuid
  status      OrganizationStatus @default(ACTIVE)
  version     Int              @default(1)
  parent      Organization?    @relation("OrganizationHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    Organization[]   @relation("OrganizationHierarchy")
  departments Department[]
  positions   Position[]
  userPositions UserPosition[]
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       User[]
  roles       Role[]
  userRoles   UserRole[]
  auditEvents AuditEvent[]
  fileObjects FileObject[]
  problemIndexes ProblemIndex[]
  problemSavedViews ProblemSavedView[]
  numberRuleVersions NumberRuleVersion[]
  numberSequences NumberSequence[]
  workflowDefinitions WorkflowDefinition[]
  workflowVersions WorkflowVersion[]
  workflowNodes WorkflowNode[]
  workflowTransitions WorkflowTransition[]
  workflowInstances WorkflowInstance[]
  workflowTasks WorkflowTask[]
  notifications Notification[]
  adminMutations AdminMutation[]
  platformSettings PlatformSettings?
  notificationRules NotificationRule[]
  positionCategories PositionCategory[]
  exportArtifacts ExportArtifact[]

  @@index([type])
  @@index([parentId])
  @@map("organizations")
}

model User {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  username       String      @db.VarChar(100)
  email          String?     @db.VarChar(254)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamptz(3)
  emailVerifications EmailVerification[]
  passwordHash   String      @map("password_hash") @db.VarChar(255)
  accountType    AccountType @map("account_type")
  status         UserStatus  @default(ACTIVE)
  mfaEnabled     Boolean     @default(false) @map("mfa_enabled")
  securityVersion Int @default(1) @map("security_version")
  mfaFailures Int @default(0) @map("mfa_failures")
  mfaBlockedUntil DateTime? @map("mfa_blocked_until") @db.Timestamptz(3)
  mfaCredential MfaCredential?
  mfaChallenges MfaChallenge[]
  recoveryCodes MfaRecoveryCode[]
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions       Session[]
  userRoles      UserRole[]
  auditEvents    AuditEvent[] @relation("AuditActor")
  uploadedFiles  FileObject[] @relation("FileUploader")
  claimedTasks WorkflowTask[] @relation("TaskClaimOwner")
  deletedFiles FileObject[] @relation("FileDeleter")
  fileUploadReceipts FileUploadReceipt[]
  problemSavedViews ProblemSavedView[]
  adminMutations AdminMutation[]
  passwordResets PasswordReset[]
  positions      UserPosition[]
  exportArtifacts ExportArtifact[]

  @@unique([organizationId, id])
  @@unique([organizationId, username])
  @@index([organizationId, accountType])
  @@index([email])
  @@map("users")
}

model EmailVerification {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  purpose String @db.VarChar(32)
  email String @db.VarChar(254)
  securityVersion Int @map("security_version")
  tokenHash String @unique @map("token_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  delivery RecoveryDelivery?
  @@index([userId, purpose, createdAt])
  @@map("email_verifications")
}

model RecoveryDelivery {
  id String @id @default(uuid()) @db.Uuid
  verificationId String @unique @map("verification_id") @db.Uuid
  encryptedPayload String? @map("encrypted_payload") @db.Text
  keyId String @map("key_id") @db.VarChar(100)
  status String @default("PENDING") @db.VarChar(20)
  attempts Int @default(0)
  processingAt DateTime? @map("processing_at") @db.Timestamptz(3)
  claimId String? @map("claim_id") @db.Uuid
  availableAt DateTime @default(now()) @map("available_at") @db.Timestamptz(3)
  sentAt DateTime? @map("sent_at") @db.Timestamptz(3)
  lastError String? @map("last_error") @db.VarChar(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  verification EmailVerification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  @@index([status, availableAt])
  @@index([status, processingAt])
  @@map("recovery_deliveries")
}

model ExportArtifact {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid
  ciphertext String? @db.Text
  rowCount Int @map("row_count")
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy User @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([expiresAt])
  @@index([organizationId, createdById, createdAt])
  @@map("export_artifacts")
}

model Department {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  parentId String? @map("parent_id") @db.Uuid
  code String @db.VarChar(64)
  name String @db.VarChar(200)
  status OrganizationStatus @default(ACTIVE)
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent Department? @relation("DepartmentHierarchy", fields: [organizationId, parentId], references: [organizationId, id], onDelete: Restrict)
  children Department[] @relation("DepartmentHierarchy")
  positions Position[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, parentId])
  @@map("departments")
}

model Position {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  departmentId String @map("department_id") @db.Uuid
  categoryId String? @map("category_id") @db.Uuid
  code String @db.VarChar(64)
  name String @db.VarChar(200)
  status OrganizationStatus @default(ACTIVE)
  version Int @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  department Department @relation(fields: [organizationId, departmentId], references: [organizationId, id], onDelete: Restrict)
  category PositionCategory? @relation(fields: [organizationId, categoryId], references: [organizationId, id], onDelete: Restrict)
  users UserPosition[]

  @@unique([organizationId, id])
  @@unique([organizationId, code])
  @@index([organizationId, departmentId])
  @@index([organizationId, categoryId])
  @@map("positions")
}

model UserPosition {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  positionId String @map("position_id") @db.Uuid
  startedAt DateTime @default(now()) @map("started_at") @db.Timestamptz(3)
  endedAt DateTime? @map("ended_at") @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user User @relation(fields: [organizationId, userId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  position Position @relation(fields: [organizationId, positionId], references: [organizationId, id], onDelete: Restrict)

  @@index([organizationId, userId, endedAt])
  @@map("user_positions")
}

model Role {
  // Global codes (organizationId = null) are unique via the partial migration index.
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  code           String           @db.VarChar(100)
  name           String           @db.VarChar(150)
  mfaRequired Boolean @default(false) @map("mfa_required")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  userRoles      UserRole[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(150)
  name        String           @db.VarChar(150)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId         String       @map("user_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, roleId, organizationId])
  @@index([organizationId, userId])
  @@index([organizationId, roleId])
  @@map("user_roles")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  securityVersion Int @default(1) @map("security_version")
  mfaVerifiedAt DateTime? @map("mfa_verified_at") @db.Timestamptz(3)
  reauthenticatedAt DateTime? @map("reauthenticated_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model MfaCredential {
  userId String @id @map("user_id") @db.Uuid
  encryptedSecret String? @map("encrypted_secret") @db.Text
  pendingSecret String? @map("pending_secret") @db.Text
  pendingExpiresAt DateTime? @map("pending_expires_at") @db.Timestamptz(3)
  lastTimeStep BigInt? @map("last_time_step")
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("mfa_credentials")
}

model MfaChallenge {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  securityVersion Int @map("security_version")
  passwordDigest String @map("password_digest") @db.Char(64)
  policyDigest String @map("policy_digest") @db.Char(64)
  organizationId String @map("organization_id") @db.Uuid
  enrollment Boolean
  attempts Int @default(0)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("mfa_challenges")
}

model MfaRecoveryCode {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  codeHash String @unique @map("code_hash") @db.Char(64)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, consumedAt])
  @@map("mfa_recovery_codes")
}

model AdminMutation {
  id String @id @default(uuid()) @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  key String @db.VarChar(128)
  action String @db.VarChar(100)
  requestDigest String @map("request_digest") @db.Char(64)
  response Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([actorUserId, organizationId, key])
  @@map("admin_mutations")
}

model PasswordReset {
  id String @id @default(uuid()) @db.Uuid
  userId String @map("user_id") @db.Uuid
  codeHash String @map("code_hash") @db.Char(64)
  expiresAt DateTime @map("expires_at") @db.Timestamptz(3)
  consumedAt DateTime? @map("consumed_at") @db.Timestamptz(3)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, consumedAt])
  @@map("password_resets")
}

model AuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  action         String        @db.VarChar(150)
  resourceType   String        @map("resource_type") @db.VarChar(100)
  resourceId     String?       @map("resource_id") @db.VarChar(128)
  outcome        String        @db.VarChar(32)
  metadata       Json          @default("{}")
  traceId        String        @map("trace_id") @db.VarChar(100)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor           User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
}

model FileObject {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  objectKey      String       @unique @map("object_key") @db.VarChar(512)
  originalName   String       @map("original_name") @db.VarChar(255)
  contentType    String       @map("content_type") @db.VarChar(150)
  sizeBytes      BigInt       @map("size_bytes")
  sha256         String       @db.Char(64)
  verifiedSha256 String?      @map("verified_sha256") @db.Char(64)
  objectVersionId String?     @map("object_version_id") @db.VarChar(1024)
  verifiedContentType String? @map("verified_content_type") @db.VarChar(150)
  verifiedSizeBytes BigInt?   @map("verified_size_bytes")
  uploadExpiresAt DateTime    @default(now()) @map("upload_expires_at") @db.Timestamptz(3)
  uploadCompletedAt DateTime? @map("upload_completed_at") @db.Timestamptz(3)
  resourceVersion Int?        @map("resource_version")
  scanStatus String          @default("WAITING_UPLOAD") @map("scan_status") @db.VarChar(24)
  scannedAt DateTime?         @map("scanned_at") @db.Timestamptz(3)
  scannerEngine String?       @map("scanner_engine") @db.VarChar(255)
  scanReason String?          @map("scan_reason") @db.VarChar(64)
  deletedAt DateTime?         @map("deleted_at") @db.Timestamptz(3)
  deletedById String?         @map("deleted_by_id") @db.Uuid
  retainUntil DateTime        @default(now()) @map("retain_until") @db.Timestamptz(3)
  status         FileStatus   @default(QUARANTINED)
  version        Int          @default(1)
  resourceType   String?      @map("resource_type") @db.VarChar(100)
  resourceId     String?      @map("resource_id") @db.VarChar(128)
  uploadedById   String       @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploadedBy     User         @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  deletedBy      User?        @relation("FileDeleter", fields: [deletedById], references: [id], onDelete: Restrict)
  uploadReceipts FileUploadReceipt[]

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@index([organizationId, resourceType, resourceId, status], map: "file_objects_resource_scope_idx")
  @@index([scanStatus, uploadExpiresAt])
  @@index([deletedById])
  @@map("file_objects")
}

model FileUploadReceipt {
  id String @id @default(uuid()) @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  key String @db.VarChar(128)
  requestDigest String @map("request_digest") @db.Char(64)
  fileId String @map("file_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  actor User @relation(fields: [actorUserId], references: [id], onDelete: Restrict)
  file FileObject @relation(fields: [fileId], references: [id], onDelete: Restrict)
  @@unique([actorUserId, key])
  @@index([fileId])
  @@map("file_upload_receipts")
}

model ProblemIndex {
  id                 String                  @id @default(uuid()) @db.Uuid
  organizationId     String                  @map("organization_id") @db.Uuid
  reportNumber       String                  @map("report_number") @db.VarChar(100)
  domainCode         String                  @map("domain_code") @db.VarChar(100)
  problemType        String                  @map("problem_type") @db.VarChar(100)
  sourceType         String                  @map("source_type") @db.VarChar(100)
  sourceId           String?                 @map("source_id") @db.Uuid
  status             ProblemStatus           @default(OPEN)
  severity           String                  @db.VarChar(32)
  responsibleParty   String?                 @map("responsible_party") @db.VarChar(200)
  ownerId            String?                 @map("owner_id") @db.Uuid
  dueAt              DateTime?               @map("due_at") @db.Timestamptz(3)
  workflowInstanceId String?                 @map("workflow_instance_id") @db.Uuid
  closedAt           DateTime?               @map("closed_at") @db.Timestamptz(3)
  archivedAt         DateTime?               @map("archived_at") @db.Timestamptz(3)
  version            Int                     @default(1)
  createdById        String?                 @map("created_by_id") @db.Uuid
  updatedById        String?                 @map("updated_by_id") @db.Uuid
  createdAt          DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization            @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workflowInstance   WorkflowInstance?       @relation(fields: [workflowInstanceId], references: [id], onDelete: Restrict)
  historicalInstances WorkflowInstance[]     @relation("InstanceProblemHistory")

  @@unique([organizationId, id])
  @@unique([organizationId, reportNumber])
  @@index([organizationId, status])
  @@index([organizationId, domainCode])
  @@index([organizationId, dueAt])
  @@index([workflowInstanceId])
  @@map("problem_indexes")
}

model NumberRuleVersion {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  ruleCode       String       @map("rule_code") @db.VarChar(100)
  version        Int          @default(1)
  pattern        String       @db.VarChar(255)
  active         Boolean      @default(false)
  createdById    String?      @map("created_by_id") @db.Uuid
  updatedById    String?      @map("updated_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, ruleCode, version])
  @@index([organizationId, ruleCode, active])
  @@map("number_rule_versions")
}

model NumberSequence {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  ruleCode       String       @map("rule_code") @db.VarChar(100)
  scopeKey       String       @default("") @map("scope_key") @db.VarChar(100)
  nextValue      BigInt       @default(1) @map("next_value")
  version        Int          @default(1)
  createdById    String?      @map("created_by_id") @db.Uuid
  updatedById    String?      @map("updated_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, ruleCode, scopeKey])
  @@index([organizationId, ruleCode])
  @@map("number_sequences")
}

model WorkflowDefinition {
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @map("organization_id") @db.Uuid
  code           String             @db.VarChar(100)
  name           String             @db.VarChar(200)
  description    String?            @db.Text
  version        Int                @default(1)
  createdById    String?            @map("created_by_id") @db.Uuid
  updatedById    String?            @map("updated_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  versions       WorkflowVersion[]
  instances      WorkflowInstance[]

  @@unique([organizationId, code])
  @@index([organizationId, name])
  @@map("workflow_definitions")
}

model WorkflowVersion {
  id                   String                 @id @default(uuid()) @db.Uuid
  organizationId       String                 @map("organization_id") @db.Uuid
  workflowDefinitionId String                 @map("workflow_definition_id") @db.Uuid
  version              Int
  status               WorkflowVersionStatus @default(DRAFT)
  publishedAt          DateTime?              @map("published_at") @db.Timestamptz(3)
  publishedById        String?                @map("published_by_id") @db.Uuid
  changeNote           String?                @map("change_note") @db.VarChar(500)
  structureSnapshot    Json                   @default("{}") @map("structure_snapshot")
  createdById          String?                @map("created_by_id") @db.Uuid
  updatedById          String?                @map("updated_by_id") @db.Uuid
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  definition           WorkflowDefinition    @relation(fields: [workflowDefinitionId], references: [id], onDelete: Cascade)
  nodes                WorkflowNode[]
  transitions          WorkflowTransition[]
  instances            WorkflowInstance[]

  @@unique([workflowDefinitionId, version])
  @@index([organizationId, status])
  @@index([organizationId, workflowDefinitionId])
  @@map("workflow_versions")
}

model WorkflowNode {
  id                 String                 @id @default(uuid()) @db.Uuid
  organizationId     String                 @map("organization_id") @db.Uuid
  workflowVersionId  String                 @map("workflow_version_id") @db.Uuid
  nodeKey            String                 @map("node_key") @db.VarChar(100)
  type               WorkflowNodeType
  name               String                 @db.VarChar(200)
  config             Json                   @default("{}")
  version            Int                    @default(1)
  createdById        String?                @map("created_by_id") @db.Uuid
  updatedById        String?                @map("updated_by_id") @db.Uuid
  createdAt          DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workflowVersion    WorkflowVersion        @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  outgoingTransitions WorkflowTransition[]  @relation("TransitionFromNode")
  incomingTransitions WorkflowTransition[]  @relation("TransitionToNode")
  currentInstances    WorkflowInstance[]    @relation("InstanceCurrentNode")
  tasks              WorkflowTask[]

  @@unique([workflowVersionId, nodeKey])
  @@index([organizationId, workflowVersionId])
  @@map("workflow_nodes")
}

model WorkflowTransition {
  id                String          @id @default(uuid()) @db.Uuid
  organizationId    String          @map("organization_id") @db.Uuid
  workflowVersionId String          @map("workflow_version_id") @db.Uuid
  transitionKey     String          @map("transition_key") @db.VarChar(100)
  action            String?         @db.VarChar(20)
  fromNodeId        String          @map("from_node_id") @db.Uuid
  toNodeId          String          @map("to_node_id") @db.Uuid
  condition         Json            @default("{}")
  version           Int             @default(1)
  createdById       String?         @map("created_by_id") @db.Uuid
  updatedById       String?         @map("updated_by_id") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization      Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workflowVersion   WorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  fromNode          WorkflowNode   @relation("TransitionFromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode            WorkflowNode   @relation("TransitionToNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@unique([workflowVersionId, transitionKey])
  @@index([organizationId, workflowVersionId])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@map("workflow_transitions")
}

model WorkflowInstance {
  id                   String                 @id @default(uuid()) @db.Uuid
  organizationId       String                 @map("organization_id") @db.Uuid
  problemIndexId       String?                @map("problem_index_id") @db.Uuid
  workflowDefinitionId String                 @map("workflow_definition_id") @db.Uuid
  workflowVersionId    String                 @map("workflow_version_id") @db.Uuid
  instanceKey          String                 @map("instance_key") @db.VarChar(150)
  taskProjectionVersion Int                   @default(0) @map("task_projection_version")
  status               WorkflowInstanceStatus @default(RUNNING)
  currentNodeId        String?                @map("current_node_id") @db.Uuid
  version              Int                    @default(1)
  createdById          String?                @map("created_by_id") @db.Uuid
  updatedById          String?                @map("updated_by_id") @db.Uuid
  createdAt            DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime               @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization         Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  definition           WorkflowDefinition    @relation(fields: [workflowDefinitionId], references: [id], onDelete: Restrict)
  workflowVersion      WorkflowVersion      @relation(fields: [workflowVersionId], references: [id], onDelete: Restrict)
  currentNode          WorkflowNode?         @relation("InstanceCurrentNode", fields: [currentNodeId], references: [id], onDelete: Restrict)
  problems             ProblemIndex[]
  historicalProblem    ProblemIndex?         @relation("InstanceProblemHistory", fields: [organizationId, problemIndexId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  tasks                WorkflowTask[]

  @@unique([organizationId, instanceKey])
  @@unique([organizationId, problemIndexId, id], map: "workflow_instances_problem_identity_key")
  @@index([organizationId, problemIndexId, createdAt], map: "workflow_instances_problem_history_idx")
  @@index([organizationId, status])
  @@index([organizationId, workflowDefinitionId, version])
  @@map("workflow_instances")
}

model WorkflowUpgrade {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @map("organization_id") @db.Uuid
  problemIndexId String @map("problem_index_id") @db.Uuid
  actorUserId String @map("actor_user_id") @db.Uuid
  beforeInstanceId String @unique @map("before_instance_id") @db.Uuid
  afterInstanceId String @unique @map("after_instance_id") @db.Uuid
  beforeProblemVersion Int @map("before_problem_version")
  afterProblemVersion Int @map("after_problem_version")
  beforeDomainRevisionId String @map("before_domain_revision_id") @db.Uuid
  afterDomainRevisionId String @map("after_domain_revision_id") @db.Uuid
  mappingVersion String @map("mapping_version") @db.VarChar(100)
  mappingSummary Json @map("mapping_summary")
  reason String @db.VarChar(1000)
  key String @db.VarChar(128)
  requestDigest String @map("request_digest") @db.Char(64)
  response Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, actorUserId, key])
  @@index([organizationId, problemIndexId, createdAt], map: "workflow_upgrades_problem_history_idx")
  @@index([actorUserId])
  @@map("workflow_upgrades")
}

model WorkflowMutation {
  id               String   @id @default(uuid()) @db.Uuid
  organizationId   String   @map("organization_id") @db.Uuid
  actorUserId      String   @map("actor_user_id") @db.Uuid
  key              String   @db.VarChar(128)
  requestDigest    String   @map("request_digest") @db.Char(64)
  instanceId       String   @map("instance_id") @db.Uuid
  workflowVersionId String  @map("workflow_version_id") @db.Uuid
  instanceVersion  Int      @map("instance_version")
  nodeId           String   @map("node_id") @db.Uuid
  action           String   @db.VarChar(20)
  response         Json
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@unique([organizationId, actorUserId, key])
  @@unique([instanceId, instanceVersion])
  @@map("workflow_mutations")
}

model WorkflowTask {
  id                 String        @id @default(uuid()) @db.Uuid
  organizationId     String        @map("organization_id") @db.Uuid
  workflowInstanceId String        @map("workflow_instance_id") @db.Uuid
  workflowVersionId  String        @map("workflow_version_id") @db.Uuid
  entryInstanceVersion Int         @default(0) @map("entry_instance_version")
  enteredAt          DateTime      @default(now()) @map("entered_at") @db.Timestamptz(3)
  workflowNodeId     String        @map("workflow_node_id") @db.Uuid
  assigneeUserId     String?       @map("assignee_user_id") @db.Uuid
  claimedByUserId    String?       @map("claimed_by_user_id") @db.Uuid
  claimedAt         DateTime?     @map("claimed_at") @db.Timestamptz(3)
  claimedBy         User?         @relation("TaskClaimOwner", fields: [claimedByUserId], references: [id], onDelete: Restrict)
  status             TaskStatus    @default(PENDING)
  dueAt              DateTime?     @map("due_at") @db.Timestamptz(3)
  completedAt        DateTime?     @map("completed_at") @db.Timestamptz(3)
  version            Int           @default(1)
  createdById        String?       @map("created_by_id") @db.Uuid
  updatedById        String?       @map("updated_by_id") @db.Uuid
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization       Organization  @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workflowInstance   WorkflowInstance @relation(fields: [workflowInstanceId], references: [id], onDelete: Cascade)
  workflowNode       WorkflowNode  @relation(fields: [workflowNodeId], references: [id], onDelete: Restrict)
  notifications      Notification[]

  @@unique([workflowInstanceId, entryInstanceVersion])
  @@index([claimedByUserId])
  @@index([organizationId, status])
  @@index([organizationId, dueAt])
  @@map("workflow_tasks")
}

model Notification {
  id             String             @id @default(uuid()) @db.Uuid
  deduplicationKey String            @unique @default(uuid()) @map("deduplication_key") @db.VarChar(200)
  organizationId String             @map("organization_id") @db.Uuid
  workflowTaskId String?            @map("workflow_task_id") @db.Uuid
  recipientUserId String?           @map("recipient_user_id") @db.Uuid
  channel        String             @db.VarChar(50)
  kind           String             @default("LEGACY") @db.VarChar(32)
  ruleVersion    Int?               @map("rule_version")
  status         NotificationStatus @default(PENDING)
  subject        String?            @db.VarChar(255)
  body           String             @db.Text
  sentAt         DateTime?          @map("sent_at") @db.Timestamptz(3)
  readAt         DateTime?          @map("read_at") @db.Timestamptz(3)
  version        Int                @default(1)
  createdById    String?            @map("created_by_id") @db.Uuid
  updatedById    String?            @map("updated_by_id") @db.Uuid
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  workflowTask   WorkflowTask?     @relation(fields: [workflowTaskId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, recipientUserId, status])
  @@index([organizationId, recipientUserId, status, createdAt, id], map: "notifications_organization_id_recipient_user_id_status_created_")
  @@index([workflowTaskId])
  @@map("notifications")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventKey      String    @unique @map("event_key") @db.VarChar(150)
  aggregateType String    @map("aggregate_type") @db.VarChar(100)
  aggregateId   String    @map("aggregate_id") @db.VarChar(128)
  eventType     String    @map("event_type") @db.VarChar(150)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int       @default(0)
  lastError     String?   @map("last_error") @db.Text
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(3)
  processingAt  DateTime? @map("processing_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, availableAt])
  @@index([status, processingAt])
  @@index([processedAt, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}

