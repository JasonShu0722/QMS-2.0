generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AccountType {
  INTERNAL
  SUPPLIER
}

enum OrganizationType {
  INTERNAL
  SUPPLIER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum FileStatus {
  QUARANTINED
  AVAILABLE
  DELETED
}

model Organization {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(64)
  name        String           @db.VarChar(200)
  type        OrganizationType
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)
  users       User[]
  roles       Role[]
  userRoles   UserRole[]
  auditEvents AuditEvent[]
  fileObjects FileObject[]

  @@index([type])
  @@map("organizations")
}

model User {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @map("organization_id") @db.Uuid
  username       String      @db.VarChar(100)
  email          String?     @db.VarChar(254)
  passwordHash   String      @map("password_hash") @db.VarChar(255)
  accountType    AccountType @map("account_type")
  status         UserStatus  @default(ACTIVE)
  mfaEnabled     Boolean     @default(false) @map("mfa_enabled")
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sessions       Session[]
  userRoles      UserRole[]
  auditEvents    AuditEvent[] @relation("AuditActor")
  uploadedFiles  FileObject[] @relation("FileUploader")

  @@unique([organizationId, username])
  @@index([organizationId, accountType])
  @@index([email])
  @@map("users")
}

model Role {
  // Global codes (organizationId = null) are unique via the partial migration index.
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String?          @map("organization_id") @db.Uuid
  code           String           @db.VarChar(100)
  name           String           @db.VarChar(150)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization?    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions    RolePermission[]
  userRoles      UserRole[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  code        String           @unique @db.VarChar(150)
  name        String           @db.VarChar(150)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId         String       @map("user_id") @db.Uuid
  roleId         String       @map("role_id") @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           Role         @relation(fields: [roleId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([userId, roleId, organizationId])
  @@index([organizationId, userId])
  @@index([organizationId, roleId])
  @@map("user_roles")
}

model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}

model AuditEvent {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  actorUserId    String?       @map("actor_user_id") @db.Uuid
  action         String        @db.VarChar(150)
  resourceType   String        @map("resource_type") @db.VarChar(100)
  resourceId     String?       @map("resource_id") @db.VarChar(128)
  outcome        String        @db.VarChar(32)
  metadata       Json          @default("{}")
  traceId        String        @map("trace_id") @db.VarChar(100)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  actor           User?         @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([actorUserId, createdAt])
  @@map("audit_events")
}

model FileObject {
  id             String       @id @default(uuid()) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  objectKey      String       @unique @map("object_key") @db.VarChar(512)
  originalName   String       @map("original_name") @db.VarChar(255)
  contentType    String       @map("content_type") @db.VarChar(150)
  sizeBytes      BigInt       @map("size_bytes")
  sha256         String       @db.Char(64)
  status         FileStatus   @default(QUARANTINED)
  version        Int          @default(1)
  resourceType   String?      @map("resource_type") @db.VarChar(100)
  resourceId     String?      @map("resource_id") @db.VarChar(128)
  uploadedById   String       @map("uploaded_by_id") @db.Uuid
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  uploadedBy     User         @relation("FileUploader", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([organizationId, status])
  @@index([organizationId, createdAt])
  @@map("file_objects")
}

model OutboxEvent {
  id            String    @id @default(uuid()) @db.Uuid
  eventKey      String    @unique @map("event_key") @db.VarChar(150)
  aggregateType String    @map("aggregate_type") @db.VarChar(100)
  aggregateId   String    @map("aggregate_id") @db.VarChar(128)
  eventType     String    @map("event_type") @db.VarChar(150)
  payload       Json
  attempts      Int       @default(0)
  lastError     String?   @map("last_error") @db.Text
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([processedAt, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}
